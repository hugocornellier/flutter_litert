+#elif defined(__APPLE__)
+/* Apple has no futex: after the spin a worker sleeps on a condition variable
+ * and the main thread has to wake it for every parallel section. The GCD
+ * backend that this pool replaced on Apple never slept between the sections
+ * of one inference, so spin as long as Android does. pthreads.c spins without
+ * holding the mutex, so a long spin costs the other threads nothing.
+ * Overridable with -DPTHREADPOOL_SPIN_PAUSE_ITERATIONS=N. */
+#define PTHREADPOOL_SPIN_YIELD_ITERATIONS 0
+#ifndef PTHREADPOOL_SPIN_PAUSE_ITERATIONS
+#define PTHREADPOOL_SPIN_PAUSE_ITERATIONS 100000
+#endif
 #else
 
