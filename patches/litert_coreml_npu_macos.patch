         CoreML::Specification::PoolingLayerParams::AVERAGE);
     pooling_params->set_globalpooling(true);
+    // The PaddingType oneof must be set even for global pooling. This branch
+    // returns before the padding block below, so leaving it unset makes Core
+    // ML reject the entire model. Global pooling covers the full spatial
+    // extent, so VALID is the correct padding.
+    pooling_params->mutable_valid();
     return layer_.release();
   }
 
