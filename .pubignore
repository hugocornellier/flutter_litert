# Exclude large iOS xcframeworks from pub package (~206 MB total).
# They are downloaded automatically during the first build via the podspec script phase.
# macOS dylibs (~13 MB) are small enough to bundle and are needed for `flutter test`.
ios/TensorFlowLiteC.xcframework/
ios/TensorFlowLiteCCoreML.xcframework/
ios/TensorFlowLiteCMetal.xcframework/
ios/LiteRt.xcframework/
ios/LiteRtMetalAccelerator.xcframework/

# flutter_litert_flex is a separate package (3.3 GB of .o files + xcframeworks)
flutter_litert_flex/
litert_flex/

# Build artifacts
build/

# flex integration-test host: local-only, not a consumer-facing example
example/flex_test_host/

# Example binary assets (model + sample images): consumers never use these;
# only example-source cloners need them, and they get them from GitHub.
example/assets/

# README/doc media: pub.dev and GitHub render these directly from the repo
# (relative README paths resolve against the repository), so they don't need
# to ship in the package archive. Keeps `pub get` lean; not used at runtime.
assets/litert-banner.png
assets/pose-then-face-demo.webp
assets/hand-detection-demo.webp
# Orphaned older demo, no longer referenced by the README. Kept out of the
# archive until the tracked file is removed from the repo.
assets/pose-detection-demo.webp

# Local delegate benchmark harnesses. Keep them in the repository for
# repeatable profiling without shipping machine-specific paths to pub.dev.
example/integration_test/coreml_model_sweep_test.dart
example/integration_test/full_delegate_sweep_test.dart
example/integration_test/gpu_fp16_test.dart
example/integration_test/ios_delegate_sweep_test.dart
example/integration_test/ios_engine_matrix_test.dart
example/lib/ios_sweep_main.dart

# Engine-overhead benchmark harness + its model asset. Kept in the
# repository for repeatable profiling; not consumer-facing.
test/benchmark/
test/assets/face_detection_short_range.tflite

# Old example subdirectories (leftover from tflite_flutter)
example/live_object_detection_ssd_mobilenet/
example/reinforcement_learning/
example/text_classification/

# Dev/CI files
.github/
.claude/
makefile
melos.yaml
scripts/
tool/
flutter-tflite.code-workspace
ffigen_tensorflow_lite.yaml

# Internal benchmark results and findings (not consumer-facing).
# The plugin builds and runs without these; they would only expose internal
# profiling data.
RESULTS.md
RESULTS.csv
COMPILEDMODEL_FINDINGS.md
